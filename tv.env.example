# Copy to tv.env (gitignored) and fill in.

# Your TV's IP address: Settings → General → Network → Network Status → IP Settings
TV_IP=192.168.1.50

# Signing profile name, as created by tools/setup-tizen.sh
CERT_PROFILE=tvlauncher

# Where the Tizen command-line tools live (default ~/tizen-studio)
# TIZEN_HOME=$HOME/tizen-studio
